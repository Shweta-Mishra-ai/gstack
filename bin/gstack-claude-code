#!/usr/bin/env -S bun --no-env-file --config=/dev/null
// Claude-only outside-review runner. Prompts arrive on stdin, never argv.
// codex_reviews gates the send (lib/outside-consent.ts); --user-invoked marks
// a review the user asked for by name (/claude-code) and runs regardless.
import { claudeCodeMain } from '../lib/claude-code';
import { outsideConsent } from '../lib/outside-consent';

const argv = process.argv.slice(2);
const userInvoked = argv.includes('--user-invoked');
const consent = outsideConsent({ userInvoked });
if (!consent.allowed) {
  process.stderr.write(consent.lines.join('\n') + '\n');
  process.stdout.write(JSON.stringify({ status: 'not_run', reason: 'consent_missing', stderr: consent.lines.join('\n') }) + '\n');
  process.exit(3);
}
process.exit(await claudeCodeMain(argv.filter(a => a !== '--user-invoked')));
