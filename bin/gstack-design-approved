#!/usr/bin/env -S bun --no-env-file --config=/dev/null
// gstack-design-approved — print the absolute path of the image an
// approved.json names.
//
// Usage: gstack-design-approved <approved.json>
//
// Prefers approved_path (relative to approved.json's directory). Legacy
// records with only approved_variant resolve to variant-<letter>.png. When the
// named image is missing, exits 1 with "approved image <path> is missing;
// reselect from the board" and never substitutes another image.

import { resolveApprovedImage } from '../design/src/approval';

const file = process.argv[2];
if (!file) {
  console.error('Usage: gstack-design-approved <approved.json>');
  process.exit(1);
}
const resolved = resolveApprovedImage(file);
if (!resolved.ok) {
  console.error(resolved.error);
  process.exit(1);
}
console.log(resolved.path);
