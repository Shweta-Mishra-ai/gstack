# capy/support.env — what the Capy skill bootstrapper (capy/skill/gstack/scripts/install.sh)
# reads from origin's default branch with `git show FETCH_HEAD:capy/support.env`,
# so a checkout too old to know today's rules learns them from the remote.
# Parsed, never sourced: KEY=<dotted number> lines only.
#
# GSTACK_MIN_REVISION: the floor. The oldest revision whose installer, trailer
# and fix lines are honest: below it the trailer fails (REVISION_BELOW_MINIMUM)
# and the bootstrapper fast-forwards a clean, unpinned checkout at install-mode
# session start (--check only reports). It is not the upgrade trigger: any
# checkout behind origin's default branch is fast-forwarded at install-mode
# session start by the checkout's own bin/gstack-capy-session (SELF_UPGRADE:
# lines; refusals skip and continue). Raise it only for install-honesty or
# security fixes, at stamp time, to the VERSION being released
# (docs/capy-install.md "Raising the supported minimum"); it never exceeds VERSION.
GSTACK_MIN_REVISION=1.91.113.0
# GSTACK_CAPY_MIN_WRAPPER: the oldest bootstrapper revision (GSTACK_CAPY_WRAPPER in
# capy/skill/gstack/scripts/install.sh) the owner should run. An older copy still
# works and prints an owner action (CAPY_WRAPPER_STALE).
GSTACK_CAPY_MIN_WRAPPER=1
